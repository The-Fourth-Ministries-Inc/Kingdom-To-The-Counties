{
  "name": "k2c-ambassador-app",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run check:syntax && node --test test/*.test.js",
    "check:syntax": "node scripts/check-syntax.mjs",
    "import:io": "node scripts/excel-to-io.mjs",
    "import:io:write": "node scripts/excel-to-io.mjs --write-index",
    "sync:scripts": "node scripts/sync-starter-scripts.mjs",
    "prepare:mobile": "node scripts/prepare-mobile.mjs",
    "patch:native": "node scripts/patch-native.mjs",
    "mobile:add:android": "npm run prepare:mobile && npx cap add android && node scripts/patch-native.mjs android",
    "mobile:add:ios": "npm run prepare:mobile && npx cap add ios && node scripts/patch-native.mjs ios",
    "mobile:sync": "npm run prepare:mobile && npx cap sync && node scripts/patch-native.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2",
    "@netlify/blobs": "^8.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "xlsx": "^0.18.5"
  }
}
